# ============================================================
# PLANTILLA DE CONFIGURACIÓN — Copiar a .env y completar
# ============================================================
# cp .env.example .env
# Luego editar .env con los valores reales.

# --- Base de datos PostgreSQL ---
POSTGRES_USER=admin_pos
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASEÑA_SEGURA
POSTGRES_DB=sistema_ventas

# --- URL de conexión para el backend ---
DATABASE_URL=postgres://admin_pos:CAMBIAR_POR_CONTRASEÑA_SEGURA@db:5432/sistema_ventas

# --- Origen del frontend para CORS ---
# Desarrollo: http://localhost:3000
# Producción: https://tudominio.com
FRONTEND_ORIGIN=http://localhost:3000

# --- Secreto de sesión Express (mín. 64 caracteres aleatorios) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
POS_SESSION_SECRET=CAMBIAR_POR_SECRETO_GENERADO_CON_CRYPTO
